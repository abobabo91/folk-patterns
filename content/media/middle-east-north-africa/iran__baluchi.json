        "thumb_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Haft-Sin_with_Stars.jpg/960px-Haft-Sin_with_Stars.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
        "full_url": "https://upload.wikimedia.org/wikipedia/commons/8/87/Haft-Sin_with_Stars.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
