    {
      "title": "(CCC No. 11. 1925) - Un prototipo de Indio Campa.png",
      "thumb_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/%28CCC_No._11._1925%29_-_Un_prototipo_de_Indio_Campa.png/960px-%28CCC_No._11._1925%29_-_Un_prototipo_de_Indio_Campa.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
