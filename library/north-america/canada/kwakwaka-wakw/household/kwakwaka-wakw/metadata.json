      "image_url": "https://media.britishmuseum.org/media/Repository/Documents/2014_11/2_21/16bf3ffb_d95a_4db7_bb08_a3d701637ce2/preview_01094585_001.jpg",
      "production_ethnic_groups": [
        "Kwakwaka'wakw",
        "Northwest Coast Peoples"
      ],
      "production_ethnic_attribution": "Made by: Kwakwaka'wakw Made by: Northwest Coast Peoples"
    }
