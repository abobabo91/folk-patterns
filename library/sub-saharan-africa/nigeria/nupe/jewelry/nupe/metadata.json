      "vision_by": "pick:cloud-claude-sonnet-5",
      "vision_reason": "A woven silk-and-cotton hair-band made at Egga on the Niger, worn by women of the higher classes as a hair ornament—this is plausible Nupe-area material culture (Egga was a Nupe/Nupe-adjacent riverine town), worn as an item of adornment.",
      "vision_confidence": "MEDIUM",
      "vision_image": "good",
      "vision_era": "traditional",
      "art_form_vision": "jewelry",
      "pick_quality": 3,
