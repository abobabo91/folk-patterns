library/
data/raw/
__pycache__/
*.pyc
.venv/
.env

# site/ is tracked; its own .gitignore keeps node_modules, dist, .env,
# .vercel and the mirrored public/data out.

# Sample images pulled down for quality checks (257 files, 70 MB). Regenerable
# by re-running the probe scripts; the verdicts that matter live in
# data/ethnicities/ and data/rejects.jsonl.
data/probes/

# Kept on purpose: data/objects/ (3325 museum-metadata JSONs, ~17 MB) and
# data/ethnicities/. Those are scrape output that costs museum API calls to
# rebuild, so they belong in the repo even though they are generated.

# Cloud vetting scratch: fetched images, rendered prompts, raw replies.
# The durable output is data/vet_verdicts/.
work/

# Image-hash cache for duplicate detection (build_index.py)
.cache/
data/pool/
